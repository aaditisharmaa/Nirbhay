# Server Configuration
PORT=5000

# Claude API Key for text classification & zone score explanations
# Optional. A local rules-based fallback is used when not set.
CLAUDE_API_KEY=your_claude_api_key_here

# Twilio Credentials for live SOS SMS delivery
# Required in production for SOS SMS delivery. The app will clearly report an unavailable provider.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Firebase Web App Config for Google Sign-In
# Required for production sign-in.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Admin service-account JSON, used to verify Firebase ID tokens on the server.
# Keep this secret server-side; do not prefix it with VITE_.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
CLIENT_ORIGIN=
ALLOW_DEVELOPMENT_AUTH=false
SEED_DATA=false
