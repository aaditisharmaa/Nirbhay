# Server Configuration
PORT=5000

# Claude API Key for text classification & zone score explanations
# Fallback: Automatic smart keyword classifier & structured explanations if not set
CLAUDE_API_KEY=your_claude_api_key_here

# Twilio Credentials for live SOS SMS delivery
# Fallback: Interactive mock SMS logger if not set
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Firebase Web App Config for Google Sign-In
# Fallback: Instant dev sign-in mode enabled if not set
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
